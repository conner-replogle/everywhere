# Security headers for static assets (Workers Static Assets). API responses get
# theirs from apps/worker/src/security.ts.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/static/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# A process's dashboard frame (/dashboard) gets its headers from the Worker
# (apps/worker/src/dashboard.ts): its CSP names our origin, which it only
# knows per request. Its scripts and fonts load cross-origin from the
# sandbox's opaque origin, hence the CORS header on /static above (they're
# public anyway).
