{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everywhere",
  "main": "src/index.ts",
  "account_id": "c6f8f04408d88cfe47437164e1c4ace2",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "ai.replogle.dev", "custom_domain": true }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/i/*", "/dashboard", "/mcp"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "everywhere",
      "database_id": "ee3cf613-66de-4322-91c7-3d1cfda32dbd",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI, for speech to text, prompt rewrites and the assistant.
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "AccountHub" },
      { "name": "ASSISTANT", "class_name": "Assistant" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AccountHub"] },
    { "tag": "v2", "new_sqlite_classes": ["Assistant"] }
  ],
  // Per-location limits on unauthenticated auth endpoints (brute-force defense).
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // The assistant's model and speech calls: a turn makes several.
    { "name": "ASSISTANT_LIMITER", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    // Where browsers and daemons reach this Worker. Override locally in .dev.vars
    // (e.g. PUBLIC_URL=http://localhost:8787); wrangler dev rewrites request URLs
    // to the production route, so the request origin can't be trusted there.
    "PUBLIC_URL": "https://ai.replogle.dev",
    // Comma-separated extra origins allowed to make API calls (dev only).
    "ALLOWED_ORIGINS": "",
    // Cloudflare Realtime TURN key (the API token is the TURN_API_TOKEN secret).
    "TURN_KEY_ID": "793c505d98567eb461a730c1cc08ac8a",
    "GITHUB_REPO": "conner-replogle/everywhere",
    "MIN_DAEMON_VERSION": "0.1.0"
  }
}
