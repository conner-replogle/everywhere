{
  "manifest_version": 3,
  "name": "everywhere: Omarchy theme",
  "version": "1.1",
  "description": "Gives everywhere (ai.replogle.dev) the current Omarchy theme to follow, and its changes.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://ai.replogle.dev/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
